# Copy to .env and fill in. Used by docker-compose.yml.
CRTWATCH_PASSWORD=change-me
# Optional: Slack or Discord incoming webhook for new hostnames/certificates.
CRTWATCH_WEBHOOK_URL=
CRTWATCH_WEBHOOK_FORMAT=slack
# Optional: lifts CertSpotter's keyless rate limit (only used if crt.sh is down).
CERTSPOTTER_API_KEY=
